rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Este app usa um sistema de login proprio (AuthContext), nao o Firebase
    // Auth nativo — por isso request.auth sempre chega nulo aqui, exatamente
    // como ja acontece no firestore.rules (allow read, write: if true).
    // A protecao de acesso e feita na camada da aplicacao, nao no Storage.
    match /materials/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 100 * 1024 * 1024;
    }
    match /uploads/materials/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 100 * 1024 * 1024;
    }
  }
}
